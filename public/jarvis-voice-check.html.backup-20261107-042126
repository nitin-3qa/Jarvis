<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>JARVIS Phase 1 — Voice Self-Test</title><style>body{margin:0;font:16px system-ui,sans-serif;background:#07141a;color:#e2f6f6}main{max-width:780px;margin:45px auto;padding:22px}h1{color:#79e8e5}button{background:#1e777e;color:white;border:1px solid #74d8df;padding:14px 18px;border-radius:9px;cursor:pointer;margin:6px 7px 6px 0;font-size:16px}button:disabled{opacity:.45}pre{background:#0b222b;border:1px solid #2b5e64;border-radius:10px;padding:18px;white-space:pre-wrap;overflow-wrap:anywhere;min-height:160px}p{line-height:1.5}a{color:#80e5fa}</style></head><body><main><h1>J.A.R.V.I.S. — Phase 1 Voice Self-Test</h1><p>This page tests your browser microphone and speech transcription independently of JARVIS. It does not modify the project or send recordings to this site. Browser speech recognition may use the browser vendor's online service.</p><p><strong>Step 1:</strong> Click Test Microphone. <strong>Step 2:</strong> Click Test Speech Recognition and say: “What is two plus two?” The recognizer stops after a single phrase.</p><button id="mic">1. Test Microphone</button><button id="speech">2. Test Speech Recognition</button><button id="stop">Stop Recognition</button><button id="copy">Copy Results</button><p><a href="/">Return to JARVIS</a></p><pre id="output" aria-live="polite"></pre></main><script>
const out=document.getElementById('output');const log=(...x)=>{out.textContent+='['+new Date().toLocaleTimeString()+'] '+x.join(' ')+'\n';};let rec=null;let listening=false;
log('Browser:',navigator.userAgent);log('Language:',navigator.language);log('Secure context:',String(isSecureContext));log('MediaDevices API:',String(!!navigator.mediaDevices?.getUserMedia));log('SpeechRecognition API:',String(!!(window.SpeechRecognition||window.webkitSpeechRecognition)));
document.getElementById('mic').onclick=async()=>{if(!navigator.mediaDevices?.getUserMedia){log('MICROPHONE: API unavailable');return;}try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});const tracks=stream.getAudioTracks();log('MICROPHONE: PASS; tracks:',String(tracks.length),'label:',tracks[0]?.label||'unknown');stream.getTracks().forEach(t=>t.stop());}catch(e){log('MICROPHONE: FAIL',e.name,e.message);}};
document.getElementById('speech').onclick=()=>{if(listening){log('Recognition already active; click Stop first.');return;}const Ctor=window.SpeechRecognition||window.webkitSpeechRecognition;if(!Ctor){log('SPEECH: unsupported by browser');return;}const r=new Ctor();rec=r;listening=true;r.lang='en-IN';r.continuous=false;r.interimResults=false;r.onstart=()=>log('SPEECH: STARTED — say What is two plus two');r.onaudiostart=()=>log('SPEECH: audio started');r.onspeechstart=()=>log('SPEECH: detected speech');r.onresult=e=>{for(let i=e.resultIndex;i<e.results.length;i++) log('TRANSCRIPT:',e.results[i][0]?.transcript||'(empty)','confidence:',String(e.results[i][0]?.confidence??'unknown'));};r.onerror=e=>log('SPEECH ERROR:',e.error,e.message||'');r.onend=()=>{listening=false;rec=null;log('SPEECH: session ended');};try{r.start();log('SPEECH: start requested');}catch(e){listening=false;rec=null;log('SPEECH START FAILED:',e.name,e.message);}};
document.getElementById('stop').onclick=()=>{try{rec?.stop();log('SPEECH: stop requested');}catch(e){log('STOP ERROR:',e.message)}};
document.getElementById('copy').onclick=async()=>{try{await navigator.clipboard.writeText(out.textContent);log('Results copied.');}catch(e){log('Copy blocked:',e.message);}};
</script></body></html>
